# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_from_botfather
CHAT_ID=your_telegram_chat_id

# Parser Configuration
CHECK_INTERVAL_SECONDS=300
INITIAL_VACANCIES_LIMIT=15
DATABASE_URL=sqlite+aiosqlite:///./data/vacancies.db

# Salary Filter
MIN_SALARY_RUB=60000

# User-Agent for HeadHunter API
HH_USER_AGENT=HH-Student-JobHunter/1.0 (contact: bagir-spb@t.me)

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_from_console_groq_com
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

